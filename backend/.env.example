# URL e chaves da API Supabase. Nunca publique SUPABASE_SECRET_KEY.
SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_COLE_SUA_CHAVE"
SUPABASE_SECRET_KEY="sb_secret_COLE_SUA_CHAVE_APENAS_NO_BACKEND"
SUPABASE_JWKS_URL="https://SEU_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"

# Copie a URI em Supabase Dashboard > Project Settings > Database > Connect.
# Mantenha sslmode=require ao usar a conexao direta do Supabase.
DATABASE_URL="COLE_AQUI_A_DATABASE_URL_DO_SUPABASE"
JWT_ACCESS_SECRET="access-secret-dev"
JWT_REFRESH_SECRET="refresh-secret-dev"
PORT=3000

# No Supabase, altere Authentication > Email Templates > Magic Link para exibir
# o token com {{ .Token }}. O aplicativo usa esse código numérico na confirmação.
