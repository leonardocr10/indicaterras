generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CONDO_ADMIN
  RESIDENT
  PROFESSIONAL
}

enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RecommendationStatus {
  ACTIVE
  REMOVED
}

enum ReportStatus {
  PENDENTE
  EM_ANALISE
  URGENTE
  RESOLVIDA
  IGNORADA
}

enum ProfessionalActionType {
  WARN
  HIDE
  SUSPEND_7
  SUSPEND_30
  BLOCK
  RESTORE
}

enum ServiceRequestUrgency {
  EMERGENCY
  TODAY
  NEXT_DAYS
  NO_RUSH
}

enum PreferredPeriod {
  MORNING
  AFTERNOON
  EVENING
  ANY
}

enum BudgetType {
  FIXED
  RANGE
  OPEN
}

enum ServiceRequestStatus {
  OPEN
  MATCHED
  CLOSED
  CANCELLED
}

enum ServiceRequestMediaType {
  IMAGE
  VIDEO
}

model Condominium {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  logo            String?              @db.Text
  coverImage      String?              @db.Text
  primaryColor    String               @default("#0F5A3C")
  secondaryColor  String               @default("#F4C542")
  address         String
  city            String
  state           String
  neighborhood    String               @default("")
  phone           String
  email           String
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  users           User[]
  recommendations Recommendation[]
  reviews         Review[]
  favorites       Favorite[]
  reports         Report[]
  settings        CondominiumSettings?
}

model User {
  id              String             @id @default(cuid())
  condominiumId   String?
  name            String
  email           String             @unique
  phone           String?
  passwordHash    String
  role            Role               @default(RESIDENT)
  emailVerified   Boolean            @default(false)
  approvalStatus  UserApprovalStatus @default(PENDING)
  active          Boolean            @default(true)
  emailVerifiedAt DateTime?
  approvedAt      DateTime?
  block           String?
  unit            String?
  zipCode         String?
  street          String?
  number          String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  condominium     Condominium?       @relation(fields: [condominiumId], references: [id])
  professional    Professional?
  recommendations Recommendation[]
  reviews         Review[]
  reviewLikes     ReviewLike[]
  reviewReplies   ReviewReply[]
  favorites       Favorite[]
  reports         Report[]
  reportHistory   ReportHistory[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordReset[]
  serviceRequests ServiceRequest[]
  notifications   Notification[]
  sentMessages    DirectMessage[]    @relation("MessageSender")
  conversations   Conversation[]     @relation("ResidentConversations")

  @@index([role, approvalStatus])
}

/// Pedido de redefinição de senha enviado por e-mail.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model CategoryGroup {
  id           String     @id @default(cuid())
  name         String     @unique
  slug         String     @unique
  icon         String?    @db.Text
  description  String?    @db.Text
  displayOrder Int        @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  categories   Category[]

  @@index([active, displayOrder])
  @@map("category_groups")
}

model Category {
  id                     String                 @id @default(cuid())
  groupId                String?
  name                   String                 @unique
  slug                   String                 @unique
  icon                   String?                @db.Text
  description            String?                @db.Text
  displayOrder           Int                    @default(0)
  active                 Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  group                  CategoryGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  professionalCategories ProfessionalCategory[]
  services               CategoryService[]
  serviceRequests        ServiceRequest[]

  @@index([groupId, active, displayOrder])
}

model CategoryService {
  id                   String                 @id @default(cuid())
  categoryId           String
  name                 String
  slug                 String
  icon                 String?                @db.Text
  displayOrder         Int                    @default(0)
  active               Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  category             Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  aliases              CategoryServiceAlias[]
  professionalServices ProfessionalService[]
  serviceRequests      ServiceRequestService[]

  @@unique([categoryId, slug])
  @@index([categoryId, active, displayOrder])
  @@map("category_services")
}

model CategoryServiceAlias {
  id                String          @id @default(cuid())
  categoryServiceId String
  alias             String
  normalizedAlias   String
  categoryService   CategoryService @relation(fields: [categoryServiceId], references: [id], onDelete: Cascade)

  @@unique([categoryServiceId, normalizedAlias])
  @@index([normalizedAlias])
  @@map("category_service_aliases")
}

model Professional {
  id                     String                 @id @default(cuid())
  userId                 String?                @unique
  name                   String
  companyName            String?
  bio                    String?                @db.Text
  phone                  String
  whatsapp               String?
  instagram              String?
  city                   String
  neighborhood           String
  avatar                 String?                @db.Text
  coverImage             String?                @db.Text
  // Centroide do bairro, preenchido pelo geocode. A precisao e de bairro, nunca
  // de endereco - a interface sempre mostra a distancia como aproximada.
  latitude               Decimal?               @db.Decimal(10, 7)
  longitude              Decimal?               @db.Decimal(10, 7)
  // Blocos de atendimento: [{ "days": [1,2,3,4,5], "start": "08:00", "end": "18:00" }]
  // com 0 = domingo. Permite mais de um bloco, ex.: semana e sabado.
  workingHours           Json?
  // Separado de `active`: pendente e quem ainda nao foi liberado pela
  // administracao; inativo e quem foi desligado ou punido. Cadastros antigos
  // nascem aprovados para nao sumirem do app.
  approvalStatus         String                 @default("APPROVED") @db.VarChar(20)
  active                 Boolean                @default(true)
  featured               Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User?                  @relation(fields: [userId], references: [id])
  professionalCategories ProfessionalCategory[]
  professionalServices   ProfessionalService[]
  recommendations        Recommendation[]
  reviews                Review[]
  favorites              Favorite[]
  reports                Report[]
  images                 ProfessionalImage[]
  actions                ProfessionalAction[]
  conversations          Conversation[]

  @@index([active, city])
}

model Conversation {
  id             String          @id @default(cuid())
  residentId     String
  professionalId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  resident       User            @relation("ResidentConversations", fields: [residentId], references: [id], onDelete: Cascade)
  professional   Professional    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  messages       DirectMessage[]

  @@unique([residentId, professionalId])
  @@index([professionalId, updatedAt])
  @@map("conversations")
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @db.Text
  type      String   @default("INFO")
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model ProfessionalService {
  id                String          @id @default(cuid())
  professionalId    String
  categoryServiceId String
  createdAt         DateTime        @default(now())
  professional      Professional    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  categoryService   CategoryService @relation(fields: [categoryServiceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, categoryServiceId])
  @@index([categoryServiceId])
  @@map("professional_services")
}

model ProfessionalCategory {
  professionalId String
  categoryId     String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([professionalId, categoryId])
}

model Recommendation {
  id             String               @id @default(cuid())
  condominiumId  String
  userId         String
  professionalId String
  comment        String?              @db.Text
  serviceDate    DateTime?
  rating         Int                  @default(0)
  status         RecommendationStatus @default(ACTIVE)
  recommended    Boolean
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  condominium    Condominium          @relation(fields: [condominiumId], references: [id])
  user           User                 @relation(fields: [userId], references: [id])
  professional   Professional         @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalId])
  @@index([professionalId, status])
}

model Review {
  id             String        @id @default(cuid())
  condominiumId  String
  userId         String
  professionalId String
  rating         Int
  comment        String        @db.Text
  serviceDate    DateTime?
  hidden         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  condominium    Condominium   @relation(fields: [condominiumId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  images         ReviewImage[]
  likes          ReviewLike[]
  replies        ReviewReply[]

  @@index([professionalId, hidden])
}

/// Fotos que o morador anexa ao comentário.
model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String   @db.Text
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

model ReviewLike {
  reviewId  String
  userId    String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@map("review_likes")
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  comment   String   @db.Text
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_replies")
}

model Favorite {
  id             String       @id @default(cuid())
  condominiumId  String
  userId         String
  professionalId String
  createdAt      DateTime     @default(now())
  condominium    Condominium  @relation(fields: [condominiumId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalId])
}

model Report {
  id             String               @id @default(cuid())
  condominiumId  String
  userId         String
  professionalId String
  reason         String
  details        String?              @db.Text
  status         ReportStatus         @default(PENDENTE)
  channel        String               @default("App do morador")
  adminNote      String?              @db.Text
  notifyParties  Boolean              @default(true)
  reviewedAt     DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  condominium    Condominium          @relation(fields: [condominiumId], references: [id])
  user           User                 @relation(fields: [userId], references: [id])
  professional   Professional         @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  images         ReportImage[]
  history        ReportHistory[]
  actions        ProfessionalAction[]

  @@index([status, createdAt])
}

/// Evidências anexadas pelo morador na denúncia.
model ReportImage {
  id        String   @id @default(cuid())
  reportId  String
  url       String   @db.Text
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_images")
}

/// Linha do tempo da denúncia: recebimento, mudanças de status, parecer e ações.
model ReportHistory {
  id        String   @id @default(cuid())
  reportId  String
  userId    String?
  kind      String
  label     String
  detail    String?  @db.Text
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([reportId, createdAt])
  @@map("report_history")
}

/// Punições aplicadas ao prestador a partir de uma denúncia.
model ProfessionalAction {
  id             String                 @id @default(cuid())
  professionalId String
  reportId       String?
  action         ProfessionalActionType
  label          String
  reason         String?                @db.Text
  startsAt       DateTime               @default(now())
  endsAt         DateTime?
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  professional   Professional           @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  report         Report?                @relation(fields: [reportId], references: [id])

  @@index([professionalId, active])
  @@map("professional_actions")
}

/// Foto de capa e trabalhos publicados pelo prestador.
model ProfessionalImage {
  id             String       @id @default(cuid())
  professionalId String
  url            String       @db.Text
  title          String?
  isCover        Boolean      @default(false)
  displayOrder   Int          @default(0)
  createdAt      DateTime     @default(now())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, isCover, displayOrder])
  @@map("professional_images")
}

model CondominiumSettings {
  id                           String      @id @default(cuid())
  condominiumId                String      @unique
  systemName                   String      @default("Terras Alphas Indica")
  condominiumName              String      @default("Terras Alphas")
  phone                        String?
  email                        String?
  primaryColor                 String      @default("#006538")
  secondaryColor               String      @default("#ffad00")
  welcomeMessage               String?     @db.Text
  supportWhatsapp              String?
  selfRegistration             Boolean     @default(true)
  requireUserApproval          Boolean     @default(true)
  requireEmailVerification     Boolean     @default(false)
  professionalSelfRegistration Boolean     @default(false)
  showBlock                    Boolean     @default(true)
  allowRecommendations         Boolean     @default(true)
  recommendationApproval       Boolean     @default(true)
  allowReviews                 Boolean     @default(true)
  requireComment               Boolean     @default(true)
  enableReports                Boolean     @default(true)
  enableFavorites              Boolean     @default(true)
  restrictedModules            Json?
  updatedAt                    DateTime    @updatedAt
  condominium                  Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@map("condominium_settings")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ServiceRequest {
  id              String                 @id @default(cuid())
  clientId        String
  categoryId      String?
  title           String
  description     String                 @db.Text
  urgency         ServiceRequestUrgency
  preferredDate   DateTime?
  preferredPeriod PreferredPeriod?
  budgetType      BudgetType?
  budgetMin       Decimal?               @db.Decimal(10, 2)
  budgetMax       Decimal?               @db.Decimal(10, 2)
  zipCode         String?
  street          String?
  number          String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?
  latitude        Decimal?               @db.Decimal(10, 7)
  longitude       Decimal?               @db.Decimal(10, 7)
  status          ServiceRequestStatus   @default(OPEN)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  closedAt        DateTime?
  client          User                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category        Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  services        ServiceRequestService[]
  media           ServiceRequestMedia[]

  @@index([clientId, createdAt])
  @@index([categoryId, status])
  @@map("service_requests")
}

model ServiceRequestService {
  id                String          @id @default(cuid())
  requestId         String
  categoryServiceId String
  request           ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  categoryService   CategoryService @relation(fields: [categoryServiceId], references: [id], onDelete: Cascade)

  @@unique([requestId, categoryServiceId])
  @@index([categoryServiceId])
  @@map("service_request_services")
}

model ServiceRequestMedia {
  id           String                  @id @default(cuid())
  requestId    String
  mediaType    ServiceRequestMediaType
  url          String                  @db.Text
  storagePath  String                  @db.Text
  displayOrder Int                     @default(0)
  createdAt    DateTime                @default(now())
  request      ServiceRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, displayOrder])
  @@map("service_request_media")
}

model AiSettings {
  id                        String   @id @default(cuid())
  enabled                   Boolean  @default(false)
  provider                  String   @default("gemini")
  model                     String   @default("gemini-3.5-flash-lite")
  apiKey                    String?  @db.Text
  endpointUrl               String?
  temperature               Decimal  @default(0.20) @db.Decimal(4, 2)
  maxOutputTokens           Int      @default(500)
  timeoutMs                 Int      @default(15000)
  problemAnalysisEnabled    Boolean  @default(true)
  categorySuggestionEnabled Boolean  @default(true)
  serviceSuggestionEnabled  Boolean  @default(true)
  summaryEnabled            Boolean  @default(true)
  clarificationEnabled      Boolean  @default(true)
  fallbackKeywordsEnabled   Boolean  @default(true)
  minimumConfidence         Decimal  @default(0.75) @db.Decimal(5, 2)
  autoApplyConfidence       Decimal  @default(0.85) @db.Decimal(5, 2)
  dailyLimit                Int?     @default(500)
  monthlyLimit              Int?     @default(10000)
  maxInputLength            Int      @default(500)
  homeTitle                 String?
  homeSubtitle              String?
  homePlaceholder           String?
  homeHelperText            String?
  successMessage            String?
  lowConfidenceMessage      String?
  fallbackMessage           String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("ai_settings")
}

model AiAnalysisLog {
  id                 String                 @id @default(cuid())
  userId             String?
  provider           String?
  model              String?
  inputText          String                 @db.Text
  normalizedText     String?                @db.Text
  matchedCategoryId  String?
  confidence         Decimal?               @db.Decimal(5, 2)
  usedAi             Boolean                @default(false)
  usedFallback       Boolean                @default(false)
  needsClarification Boolean                @default(false)
  responseJson       Json?
  status             String                 @default("success")
  errorMessage       String?                @db.Text
  latencyMs          Int?
  adminFeedback      String?
  createdAt          DateTime               @default(now())
  services           AiAnalysisLogService[]

  @@index([createdAt])
  @@index([userId])
  @@map("ai_analysis_logs")
}

model AiAnalysisLogService {
  id        String        @id @default(cuid())
  logId     String
  serviceId String
  score     Int?
  position  Int           @default(0)
  log       AiAnalysisLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
  @@map("ai_analysis_log_services")
}

model MailSettings {
  id        String   @id @default(cuid())
  enabled   Boolean  @default(false)
  host      String?
  port      Int      @default(587)
  // 465 usa TLS implicito; 587 usa STARTTLS. Guardado para nao depender da porta.
  secure    Boolean  @default(true)
  username  String?
  // Nunca devolvida por inteiro na API: o painel recebe mascarada.
  password  String?  @db.Text
  fromName  String?
  fromEmail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mail_settings")
}
