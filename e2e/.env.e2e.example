# Copie para e2e/.env.e2e e ajuste. Este arquivo NAO vai para o Git.

# ---------------------------------------------------------------------------
# Banco de teste (MySQL local). NUNCA aponte para o banco de producao.
# O usuario/senha abaixo sao criados por `npm run db:e2e:setup`.
# ---------------------------------------------------------------------------
E2E_DATABASE_URL="mysql://indicafacil_e2e:e2e_local_only@localhost:3306/indicafacil_e2e"

# Credenciais do MySQL usadas APENAS para criar o banco de teste na primeira vez.
E2E_MYSQL_ADMIN_USER="root"
E2E_MYSQL_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Enderecos da aplicacao sob teste
# ---------------------------------------------------------------------------
E2E_BASE_URL="http://localhost:4200"
E2E_API_URL="http://localhost:3000/api"

# Porta em que a API de teste sobe (isolada da API de desenvolvimento em 3000).
E2E_API_PORT="3000"

# ---------------------------------------------------------------------------
# Comportamento da suite
# ---------------------------------------------------------------------------
# true  -> o Playwright sobe backend e frontend sozinho (padrao local)
# false -> voce ja subiu os servidores na mao / esta em CI apontando para staging
E2E_MANAGE_SERVERS="true"

# Roda o seed antes da suite. Desligue para depurar um teste sem resetar o banco.
E2E_RESET_DB="true"

# Chave real do Gemini. Deixe vazio: os testes @ai-real sao pulados sem ela.
E2E_GEMINI_API_KEY=""

# Chave real do Google Maps. Deixe vazio: os testes @maps-real sao pulados.
E2E_GOOGLE_MAPS_API_KEY=""
